{
  "name": "mfc-js",
  "version": "0.24.0-cherrypick.9",
  "description": "An MFC parser implementation with TypeScript",
  "exports": {
    ".": {
      "types": "./built/index.d.ts",
      "import": "./built/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "pnpm run tsc",
    "tsc": "tsc --project tsconfig.build.json",
    "tsd": "tsd",
    "parse": "node ./built/cli/parse",
    "parse-simple": "node ./built/cli/parseSimple",
    "api": "pnpm api-extractor run --local --verbose",
    "api-prod": "pnpm api-extractor run --verbose",
    "lint": "eslint './**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint './**/*.{js,jsx,ts,tsx}' --fix",
    "jest": "jest --coverage",
    "test": "pnpm run jest && pnpm run tsd"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kokonect-link/mfc.js.git"
  },
  "author": "Marihachi",
  "license": "MIT",
  "devDependencies": {
    "@microsoft/api-extractor": "7.47.11",
    "@types/jest": "29.5.14",
    "@types/node": "22.9.0",
    "@typescript-eslint/eslint-plugin": "7.17.0",
    "@typescript-eslint/parser": "7.17.0",
    "jest": "29.7.0",
    "ts-jest": "29.1.1",
    "ts-node": "10.9.2",
    "tsd": "0.30.0",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@twemoji/parser": "15.0.0"
  },
  "files": [
    "built",
    "CHANGELOG.md",
    "CHANGELOG_CHERRYPICK.md"
  ]
}
